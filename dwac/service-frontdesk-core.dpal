artifact service_frontdesk_core kind=taowind.software/web-application {
  goal "把 Clinic Flow 抽象为通用服务业 AI 前台核心，并将牙科变成第一个 vertical pack；后续可复制到宠物美容/寄养、美容、汽车维修、清洁/家居服务、水电"
  success "核心客户沟通、预约、提醒、改期取消、日历同步、摘要和人工接管不依赖牙科概念"
  success "新增行业只需行业包，不复制核心代码"
  constraint "Clinic Flow 继续作为 dental vertical 可运行实例，不破坏现有演示"
  constraint "行业包不得提升 Agent 到医疗诊断、治疗建议或其他受限专业判断"
  invariant "所有租户数据继续按 tenant/clinic scope 隔离"
  invariant "core 不硬编码牙科服务、牙科召回或牙科紧急词"
  invariant "匹配只使用完成服务所需的最小字段，排序可解释且不替代人工判断"
  invariant "Hold/Confirm 必须幂等、带过期时间并阻止同一资源重叠预订"
  invariant "Job 使用公开身份标识；私有联系方式默认不进入客户、员工或 Agent 上下文"
  invariant "精确地址只能由 Privacy Broker 按服务目的、阶段和同意逐步披露"
  invariant "WhatsApp 只能作为渠道，所有发送动作必须经过既有 Policy Gate"
  owner "service-frontdesk-core"

  unit core_domain output=taowind/schema {
    title "通用服务业领域模型"
    goal "定义 Customer/Subject/Service/Resource/Booking/Conversation/FollowUp 的通用语义"
    accept "vertical_neutral,tenant_scoped"
  }

  unit vertical_contract output=taowind/api_contract {
    title "行业包契约"
    goal "行业包提供名称、对象类型、服务、FAQ、风险升级规则、召回规则、适配目标"
    depends "core_domain"
    accept "plugin_style,no_core_fork"
  }

  unit dental_pack output=taowind/configuration {
    title "牙科行业包"
    goal "把现有牙科 FAQ、服务、紧急词、洗牙召回、CMS 适配目标迁入行业包"
    depends "vertical_contract"
    accept "behavior_preserved"
  }

  unit pet_pack output=taowind/configuration {
    title "宠物美容/寄养行业包候选"
    goal "证明新行业可只通过配置包接入，不改核心"
    depends "vertical_contract"
    accept "no_core_code_change,candidate_only"
  }

  unit home_service_pack output=taowind/configuration {
    title "家居服务行业包候选"
    goal "覆盖上门地址、时段、服务人员等字段，为 field-service 类行业验证扩展性"
    depends "vertical_contract"
    accept "field_service_shape,candidate_only"
  }

  unit core_frontdesk output=taowind/workflow {
    title "通用 AI 前台编排"
    goal "FAQ/预约/风险升级/人工接管只读取 vertical contract，不读取牙科常量"
    depends "vertical_contract,core_domain"
    accept "vertical_driven,fail_closed"
  }

  unit smart_scheduling_core output=taowind/workflow {
    title "通用智能排班与预约核心"
    goal "以服务请求、人员能力、服务区域、时长和缓冲时间完成硬约束匹配、五分钟 Hold、幂等 Confirm、回滚和通知编排"
    depends "core_domain,vertical_contract"
    accept "hard_constraints,explainable_ranking,no_double_booking,idempotent_confirm,rollback_safe,candidate_only"
  }

  unit privacy_broker output=taowind/security_contract {
    title "Privacy Broker"
    goal "分离 Job 公开身份与私有身份，按目的/阶段/同意最小化披露精确地址和联系方式，并记录审计事件"
    depends "core_domain,smart_scheduling_core"
    accept "purpose_bound,consent_bound,progressive_disclosure,audit_default_deny,candidate_only"
  }

  unit dual_agent_communication output=taowind/workflow {
    title "客户 Agent 与服务人员 Agent 通信模型"
    goal "以结构化 ConversationIntent 驱动可解释流程；支持人工接管、暂停、STOP/退订和隐私边界，不允许模型直接执行"
    depends "core_frontdesk,privacy_broker,vertical_contract"
    accept "structured_intents,human_takeover,whatsapp_policy_gate,prompt_injection_resistant,identity_separated,candidate_only"
  }

  unit ui_branding output=taowind/ui {
    title "行业驱动 UI 文案"
    goal "页面标题、客户/病人称谓、服务对象称谓由行业包驱动；Material Design 3 保持"
    depends "vertical_contract,core_frontdesk"
    accept "material_design_3,vertical_labels"
  }

  unit tests output=taowind/test {
    title "行业抽象定向测试"
    goal "验证牙科行为保持、行业包隔离、排班边界、隐私披露、Agent 接管、WhatsApp Policy Gate、租户隔离和提示注入防护"
    depends "dental_pack,pet_pack,home_service_pack,core_frontdesk,smart_scheduling_core,privacy_broker,dual_agent_communication"
    accept "targeted_only,negative_cases,idempotency_cases,tenant_boundary_cases,prompt_injection_cases"
  }
}
