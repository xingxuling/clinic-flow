# Service Frontdesk 本地开发配置模板
# 复制为 .env 后自行生成随机密钥；不要把真实密钥提交到 GitHub。
# 两把密钥必须不同，且至少 32 个字符。

CLINIC_FLOW_TOKEN_SECRET=replace-with-random-token-secret-at-least-32-chars
CLINIC_FLOW_SESSION_SECRET=replace-with-different-random-session-secret-32-chars

# -----------------------------------------------------------------------------
# Meta WhatsApp Business Platform / Cloud API（server-only）
# -----------------------------------------------------------------------------
# 正式 WhatsApp 自动化不得使用普通 WhatsApp / WhatsApp Business App 模拟。
# Access Token 与 Phone Number ID 只能存在服务器环境，不可暴露为 VITE_*。
# Graph API 版本刻意由部署环境显式提供，避免代码长期硬编码过期版本。

META_WHATSAPP_ACCESS_TOKEN=replace-with-server-only-meta-access-token
META_WHATSAPP_PHONE_NUMBER_ID=replace-with-meta-phone-number-id
META_GRAPH_API_VERSION=vXX.X
